{
  "name": "figma-plugin-starter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "helper:build": "node scripts/build-helper.mjs",
    "build": "npm run helper:build && npm run typecheck && node scripts/build.mjs",
    "dev": "npm run helper:build && node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "test": "node --test tests/*.test.mjs",
    "converter": "node converter/server.mjs",
    "setup:browser": "node scripts/setup-browser.mjs",
    "setup:gs": "node scripts/setup-ghostscript.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@figma/plugin-typings": "latest",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "playwright": "^1.58.0",
    "pdf-lib": "^1.17.1"
  }
}
